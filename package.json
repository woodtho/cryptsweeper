{
  "name": "flag-the-deep",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run build && cap run android",
    "android:build": "npm run android:sync && cap build android",
    "predeploy": "npm version patch --no-git-tag-version && npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "cards:render": "npm run build && node scripts/render-card-sheets.mjs",
    "graft:init": "graft init --agents agents --no-global",
    "graft:build": "graft build",
    "graft:map": "graft map",
    "test": "node test/smoke.test.mjs && node test/events.test.mjs && node test/puzzles.test.mjs && node test/sprite-playback.test.mjs && node test/architecture.test.mjs",
    "bot": "node src/bot/cli.mjs",
    "balance": "node src/bot/balance.mjs --runs=100 --honest-runs=20 --output=balance-report.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@nanonets/graft": "0.8.2",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "vite": "^6.0.0"
  }
}
